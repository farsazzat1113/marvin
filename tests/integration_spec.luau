test('claim is not blocked by a slow broadcast; preparation precedes claim ACK',function()
    reset({autoJoin=true,autoSteal=false,remote=true,reportDelay=5,keyDelay=20})
    executeScript();Scheduler.advance(0.5)
    expect(#state.teleports==1,'Slow report held the claim lane')
    local ack,hop
    for i,item in ipairs(state.log)do if item.kind=='claimAck'then ack=i end;if item.kind=='teleport'then hop=i end end
    expect(ack and hop and hop>ack)
    for i=ack+1,hop-1 do local k=state.log[i].kind;expect(k~='file'and k~='queue'and k~='teleSetting','Preparation occurred after ACK')end
    expect(state.log[hop].at-state.log[ack].at<=1/60+1e-6)
    expect(state.queuePayload:find('/farsazzat1113/marvin/Marvin/',1,true)~=nil,'Queued loader still points to the old backup')
    expect(state.teleSettings.UNKNOWNJoinedEggV1.uid=='remote-egg')
    expect(state.teleSettings.UNKNOWNValidatedHopV1.jobId=='remote-job')
end)
test('a newly received head page wakes Auto Join on the same scheduler frame',function()
    reset({autoJoin=true,autoSteal=false,remote=false,keyDelay=20})
    executeScript();Scheduler.advance(0.35)
    expect(#state.teleports==0)
    state.options.remote=true;Scheduler.advance(0.45)
    expect(#state.teleports==1)
    local response,claim
    for _,item in ipairs(state.log)do
        if item.kind=='feedAck'and item.info>0 and not response then response=item.at end
        if item.kind=='request'and item.info:find('/v1/join',1,true)then claim=item.at;break end
    end
    expect(response and claim and claim-response<=1/60+1e-6)
end)
