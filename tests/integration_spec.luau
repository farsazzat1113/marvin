local function countRequests(path)
    local n=0;for _,item in ipairs(state.requests)do if item.url:find(path,1,true)then n+=1 end end;return n
end
local function settingToggle(title)
    for _,obj in ipairs(state.playerGui:GetDescendants())do
        if obj:IsA('TextLabel')and obj.Text==title then
            for _,child in ipairs(obj.Parent:GetChildren())do if child:IsA('TextButton')then return child end end
        end
    end
    error('Missing settings toggle '..title)
end
local function safeTrajectory(hitbox)
    local previous=Vector3.new(0,0,0)
    for _,position in ipairs(state.trajectory or{})do
        local feet=Vector3.new(position.X,0,position.Z)
        expect(not Policy.segmentHitsBox(previous,feet,hitbox.CFrame,hitbox.Size,Vector3.new(2.1,4,2.1)),'Path entered padded trap Hitbox')
        previous=feet
    end
end

test('tracked hop begins while key refresh and reporting are still pending',function()
    reset({keyDelay=5,reportDelay=4})
    executeScript();Scheduler.advance(0.1)
    expect(state.playerGui:FindFirstChild('UNKNOWN')~=nil)
    expect(state.playerGui:FindFirstChild('UNKNOWN_KeySystem')==nil)
    expect(state.root.Position.X>0,'Movement was gated by HTTP')
    expect(state.world:GetAttribute('ClientObbyAntiTp')==false)
    Scheduler.advance(3.5)
    expect(#state.carryCalls==1 and #state.plantCalls==1,'Expected one pickup and one plant')
    expect(state.carryCalls[1].at<1.1,'Unexpected pickup/settle delay')
    expect(state.humanoid.Health==100);near(state.humanoid.WalkSpeed,16)
end)
test('arrival calls carry immediately and home uses only bounded physical steps',function()
