test('async teleport failure advances candidates; an old watchdog cannot clear a newer trip',function()
    reset({autoJoin=true,autoSteal=false,remote=true,remoteSecond=true,keyDelay=20})
    executeScript();Scheduler.advance(0.4);expect(#state.teleports==1)
    state.services.TeleportService.TeleportInitFailed:Fire(state.player,Enum.TeleportResult.Failure,'unavailable',42)
    Scheduler.advance(0.4);expect(#state.teleports==2);expect(state.teleports[2].job=='second-job')
    state.services.TeleportService.TeleportInitFailed:Fire(state.player,Enum.TeleportResult.Failure,'late old failure',42,{ServerInstanceId='remote-job'})
    Scheduler.advance(11.4)
    expect(#state.teleports==2,'Old watchdog reset the newer trip')
    expect(state.teleSettings.UNKNOWNJoinedEggV1.jobId=='second-job')
end)
test('slow pagination cannot starve head polling and duplicate pages are bounded',function()
    reset({autoSteal=false,remote=true,repeatPage=true,pageDelay=2,keyDelay=20})
    executeScript();Scheduler.advance(3.2)
    local head=0
    for _,req in ipairs(state.requests)do if req.url:find('/v1/eggs',1,true)and req.url:find('&offset=0',1,true)then head+=1 end end
    expect(head>=4,'Pagination starved fresh reports')
    Scheduler.advance(4);expect(countRequests('/v1/eggs')<20,'Duplicate pagination ran away')
end)
