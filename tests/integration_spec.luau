test('queued runtime retries downloads, rejects older builds and respects Auto Execute OFF',function()
    local function runQueue(response,disabled)
        reset({tracked=false,autoSteal=false,keyDelay=20});executeScript();Scheduler.advance(0.1)
        local payload=state.queuePayload;expect(payload~=nil)
        local downloads,executions=0,0
        game.HttpGet=function()downloads+=1;return response=='current' and ('-- '.._G.__UNKNOWN_BUILD..'\nreturn true') or '-- older UI21 source'end
        if disabled then state.teleSettings.UNKNOWNAutoExecuteV1=false end
        local fn=assert(loadstring(payload))
        local env=setmetatable({game=game,task=task,os=os,readfile=readfile,getgenv=getgenv,_G=_G,warn=warn,
            loadstring=function()return function()executions+=1 end end},{__index=getfenv(0)})
        setfenv(fn,env);task.spawn(fn);Scheduler.advance(4)
        return downloads,executions
    end
    local downloads,executions=runQueue('current',false);expect(downloads==1 and executions==1)
    downloads,executions=runQueue('old',false);expect(downloads==3 and executions==0)
    downloads,executions=runQueue('current',true);expect(downloads==0 and executions==0)
end)

