test('respawn invalidates the old route and reacquires a dropped egg after cooldown',function()
    reset({keyDelay=20})
    executeScript();Scheduler.advance(0.9)
    expect(#state.carryCalls==1,'Fixture should be carrying before respawn')
    local oldHumanoid=state.humanoid;local old=state.character
    state.player.CharacterRemoving:Fire(old);oldHumanoid.Health=0;oldHumanoid.Died:Fire()
    state.carry={IsCarrying=false};state.records['egg-1'].State='Dropped'
    local new=state.characterAt(0,0);state.player.CharacterAdded:Fire(new);old:Destroy()
    Scheduler.advance(10)
    expect(#state.carryCalls==2 and #state.plantCalls==1)
    expect(oldHumanoid.MoveDirection.Magnitude==0);expect(state.world:GetAttribute('ClientObbyAntiTp')==false)
end)
